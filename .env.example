# Public site URL — used for canonical tags, JSON-LD, and sitemap.
NEXT_PUBLIC_SITE_URL=https://bamboofiredelray.com

# Google Maps Embed API key — exposed publicly via NEXT_PUBLIC_*; restrict by HTTP referrer in
# Google Cloud Console (e.g. *.bamboofiredelray.com/*, localhost:3000/*).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
